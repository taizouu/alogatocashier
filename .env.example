# ===========================================
# AloGato Cashier - Variables de Entorno
# ===========================================
# Copia este archivo como .env y completa los valores reales:
#   cp .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=genera-una-clave-secreta-aqui
DEBUG=True

# --- Base de Datos (PostgreSQL) ---
DB_NAME=alogato_cashier
DB_USER=postgres
DB_PASSWORD=tu-contraseña-de-postgres
DB_HOST=localhost
DB_PORT=5432

# --- Shopify ---
SHOPIFY_CLIENT_ID=tu-client-id
SHOPIFY_CLIENT_SECRET=tu-client-secret
SHOPIFY_STORE_URL=tu-tienda.myshopify.com
SHOPIFY_LOCATION_ID=tu-location-id
