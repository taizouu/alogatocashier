# ============================================================
#  .env del SERVIDOR (copia de este archivo en /opt/alogato/.env)
#  instalar.sh lo crea con DJANGO_SECRET_KEY y DB_PASSWORD ya generados.
#  Completa el resto copiando los valores de tu .env del PC.
# ============================================================

# --- Dirección pública ---
DOMINIO=caja.alogato.cl
DJANGO_ALLOWED_HOSTS=caja.alogato.cl
CSRF_TRUSTED_ORIGINS=https://caja.alogato.cl

# --- Django y base de datos (generados por instalar.sh; no los cambies después) ---
DJANGO_SECRET_KEY=__GENERAR__
DB_NAME=alogato_cashier
DB_USER=alogato
DB_PASSWORD=__GENERAR__

# --- Shopify (copia de tu .env del PC) ---
SHOPIFY_STORE_URL=ban51g-ye.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_LOCATION_ID=

# --- Comprobante impreso (copia de tu .env del PC, si los tienes) ---
TIENDA_NOMBRE=AloGato GraffStore
TIENDA_RUT=
TIENDA_DIRECCION=
TIENDA_TELEFONO=
TIENDA_WEB=alogato.cl

# --- Pago remoto TUU ---
TUU_PAGO_REMOTO_ACTIVO=true
TUU_API_KEY=
TUU_POS_SERIAL=TJ44246421916

# --- Boletas y facturas (OpenFactura). En pruebas: dev. Documentos reales: prod + datos del emisor ---
OPENFACTURA_ACTIVO=true
OPENFACTURA_AMBIENTE=dev
OPENFACTURA_API_KEY=
EMISOR_RUT=
EMISOR_RAZON_SOCIAL=
EMISOR_GIRO=
EMISOR_ACTECO=
EMISOR_DIRECCION=
EMISOR_COMUNA=
EMISOR_SUCURSAL=
